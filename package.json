{
  "name": "pi-thunder-context-management",
  "version": "0.1.1",
  "description": "Context management for long-running Pi agents: deep pruning at task boundaries and on a cold cache, with agent compaction as the backstop. One extension, coordinators and subagents alike.",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./view": "./view.ts"
  },
  "license": "MIT",
  "author": "Mandalorian007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/pi-thunder-context-management.git"
  },
  "homepage": "https://github.com/Mandalorian007/pi-thunder-context-management#readme",
  "bugs": "https://github.com/Mandalorian007/pi-thunder-context-management/issues",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "context",
    "compaction",
    "prompt-caching",
    "agents"
  ],
  "files": [
    "index.ts",
    "view.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.18.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
